{
  "name": "budget_app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/run.mjs next dev -H 127.0.0.1",
    "build": "node scripts/run.mjs next build",
    "start": "node scripts/run.mjs next start -H 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "reset-data": "node scripts/reset-data.mjs",
    "sync": "node scripts/run.mjs tsx --conditions=react-server scripts/sync.mts",
    "key:to-keychain": "node scripts/move-key-to-keychain.mjs",
    "app": "npm run build && npm run start",
    "desktop": "node scripts/build-desktop.mjs && electron .",
    "desktop:package": "node scripts/build-desktop.mjs && electron-builder --mac --arm64 --x64",
    "desktop:package:dir": "node scripts/build-desktop.mjs && electron-builder --mac --dir"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.6",
    "plaid": "^47.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-plaid-link": "^5.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "productName": "Budget",
  "main": "electron/main.mjs",
  "build": {
    "appId": "com.budgetapp.desktop",
    "productName": "Budget",
    "copyright": "Copyright © 2026 Budget App contributors",
    "directories": {
      "output": "dist-desktop",
      "buildResources": "resources"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!**/node_modules/**"
    ],
    "afterPack": "scripts/after-pack.mjs",
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.finance",
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "artifactName": "Budget-${version}-${arch}.${ext}",
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "Budget-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "releaseType": "draft"
    }
  },
  "description": "Local-only personal budgeting app (Next.js, SQLite, Plaid)"
}
